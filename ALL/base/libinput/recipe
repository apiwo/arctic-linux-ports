# libinput - Input device handling
#
# libwacom, the debug GUI and the test suite are all off: libwacom is a
# tablet database Arctic does not package, and meson treats it as a hard
# dependency unless told otherwise.
name=libinput
version=1.30.0
release=1
desc="Input device handling"
url="https://www.freedesktop.org/wiki/Software/libinput/"
license="MIT"
depend="glibc libevdev mtdev libudev-zero"
makedepend="meson ninja"
source="https://gitlab.freedesktop.org/libinput/libinput/-/archive/1.30.0/libinput-1.30.0.tar.gz"
sha256="SKIP"

build() {
	cd "libinput-1.30.0"
	meson setup build \
		--prefix=/usr \
		--libdir=/usr/lib \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--buildtype=release \
		--wrap-mode=nodownload \
		-Db_lto=true \
		-Dlibwacom=false \
		-Ddebug-gui=false \
		-Dtests=false \
		-Ddocumentation=false
	ninja -C build -j"$JOBS"
}

package() {
	cd "libinput-1.30.0"
	DESTDIR="$pkgdir" ninja -C build install
}
