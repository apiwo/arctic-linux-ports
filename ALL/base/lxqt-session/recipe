name=lxqt-session
version=2.2.0
release=1
desc="The LXQt session manager"
url="https://lxqt-project.org/"
license="LGPL-2.1-or-later"
depend="glibc liblxqt qt6-base libxscrnsaver"
makedepend=""
source="https://github.com/lxqt/lxqt-session/releases/download/2.2.0/lxqt-session-2.2.0.tar.xz"
sha256="SKIP"

build() {
	cmake -S "lxqt-session-2.2.0" -B build -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_BUILD_TYPE=Release \
		-DBUILD_SHARED_LIBS=ON
	ninja -C build -j"$JOBS"
}

package() {
	DESTDIR="$pkgdir" ninja -C build install
}
