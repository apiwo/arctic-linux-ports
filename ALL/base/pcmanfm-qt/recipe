name=pcmanfm-qt
version=2.2.0
release=1
desc="The LXQt file manager"
url="https://lxqt-project.org/"
license="GPL-2.0-or-later"
depend="glibc liblxqt qt6-base"
makedepend=""
source="https://github.com/lxqt/pcmanfm-qt/releases/download/2.2.0/pcmanfm-qt-2.2.0.tar.xz"
sha256="SKIP"

build() {
	cmake -S "pcmanfm-qt-2.2.0" -B build -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_BUILD_TYPE=Release \
		-DBUILD_SHARED_LIBS=ON
	ninja -C build -j"$JOBS"
}

package() {
	DESTDIR="$pkgdir" ninja -C build install
}
