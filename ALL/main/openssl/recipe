# openssl - TLS toolkit, for software that insists on it
# Generated from manifest.tsv by gen-ports.py. Edit the manifest, not this file,
# unless the package needs something the template cannot express - in which case
# drop a `recipe.local` beside it and it will be preserved.
name=openssl
version=3.6.2
release=1
desc="TLS toolkit, for software that insists on it"
url="https://openssl.org/"
license="Apache-2.0"
depend="glibc"
makedepend="perl"
source="https://github.com/openssl/openssl/releases/download/openssl-3.6.2/openssl-3.6.2.tar.gz"
sha256="SKIP"

build() {
	cd "openssl-3.6.2"
	# openssl's own Configure (capital C, a perl script) is not autoconf -
	# no --help output listing options the generic template's usual dance
	# expects, and it takes a target name as its first argument rather than
	# just flags.
	./Configure linux-x86_64 \
		--prefix=/usr --openssldir=/etc/ssl --libdir=lib \
		shared no-docs
	make -j"$JOBS"
}

package() {
	cd "openssl-3.6.2"
	# install_sw + install_ssldirs: the binaries/libs/headers and the
	# /etc/ssl layout (openssl.cnf, cert dirs), skipping install_docs -
	# openssl's man pages are a separate multi-thousand-file tree this port
	# has no need to ship.
	make DESTDIR="$pkgdir" install_sw install_ssldirs
}
